# Ignore les dossiers .terraform (plugins, modules, téléchargements)  
**/.terraform/*

# Fichiers d’état de Terraform (tfstate)  
*.tfstate  
*.tfstate.*  

# Fichiers de plan / sortie binaire  
*.tfplan  

# Fichiers variables (peuvent contenir des secrets)  
*.tfvars  
*.tfvars.json  

# Fichiers de remplacement / override  
override.tf  
override.tf.json  
*_override.tf  
*_override.tf.json  

# Fichiers de log / crash  
crash.log  
crash.*.log  

# Fichiers de configuration du CLI Terraform  
.terraformrc  
terraform.rc  

# Fichiers personnels / IDE  
*.swp  
*.bak  
*.tmp  
.vscode/  
.idea/  

# Fichiers de clé / données sensibles  
*.pem  
*.key  
*.crt  
